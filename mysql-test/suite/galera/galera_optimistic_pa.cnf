[mysqld.1]
wsrep_provider_options='cert.optimistic_pa=yes;base_port=@mysqld.1.#galera_port;@ENV.WSREP_PROVIDER_TIMEOUTS'

[mysqld.2]
wsrep_provider_options='cert.optimistic_pa=yes;base_port=@mysqld.2.#galera_port;@ENV.WSREP_PROVIDER_TIMEOUTS'

[mysqld.1]
early_plugin_load=keyring_file.so
keyring_file_data=@ENV.MYSQL_TMP_DIR/mysqld.1/keyring.1

[mysqld.2]
early_plugin_load=keyring_file.so
keyring_file_data=@ENV.MYSQL_TMP_DIR/mysqld.2/keyring.2
