#
# mwb-1861
#
# Attempting BF abort of SELECT ... FOR UPDATE SKIP LOCKED
# caused: Assertion failure: lock0lock.cc:1904:
#   nullptr == lock_rec_other_has_conflicting(mode, block, heap_no, trx).wait_for
#

--source include/galera_cluster.inc
--source include/have_debug_sync.inc

#
# Setup: CREATE a table with records 1,2,3 and lock
# record 2.
#
CREATE TABLE t1 (f1 INTEGER PRIMARY KEY);
INSERT INTO t1 VALUES (1);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (3);

--connect node_1a, 127.0.0.1, root, , test, $NODE_MYPORT_1
START TRANSACTION;
SELECT * FROM t1 WHERE f1 = 2 FOR UPDATE;

#
# Insert one more record, will use it to create a conflict.
# Then block SELECT ... FOR UPDATE SKIP LOCKED when it skips
# over record 2.
#
--connection node_1
START TRANSACTION;
INSERT INTO t1 VALUES (4);
SET DEBUG_SYNC='skip_locked SIGNAL wait WAIT_FOR continue';

--send SELECT * FROM t1 FOR UPDATE SKIP LOCKED

#
# Wait for debug sync point to be reached, and BF abort the
# transaction.
#
--connect node_1b, 127.0.0.1, root, , test, $NODE_MYPORT_1
--connection node_1b
SET SESSION wsrep_sync_wait=0;

SET GLOBAL DEBUG = "+d,sync.wsrep_apply_cb";

--connection node_2
INSERT INTO t1 VALUES (4);

--connection node_1b
SET DEBUG_SYNC='now WAIT_FOR sync.wsrep_apply_cb_reached';
SET GLOBAL DEBUG = "-d,sync.wsrep_apply_cb";

#
# Let both continue.
# If bug is present: SELECT FOR UPDATE SKIP LOCKED will trigger
# the assertion.
#
SET DEBUG_SYNC='now SIGNAL signal.wsrep_apply_cb';
--sleep 1
SET DEBUG_SYNC='now SIGNAL continue';
SET DEBUG_SYNC='RESET';

#
# Expect SELECT FOR UPDATE SKIP LOCKED to be BFed
#
--connection node_1
--error ER_LOCK_DEADLOCK
--reap

#
# Cleanup
#
--connection node_1a
COMMIT;
SELECT * FROM t1;

DROP TABLE t1;
