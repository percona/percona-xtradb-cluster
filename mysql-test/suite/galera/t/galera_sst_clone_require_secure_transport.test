#
# PXC-5289: wsrep_sst_clone must work with require_secure_transport=ON.
#
# With require_secure_transport=ON the Recipient (Joiner's temporary clone
# instance, which is started with the Joiner's config file) rejects unencrypted
# connections. Before the fix, wsrep_sst_clone.sh forced --ssl-mode=DISABLED on
# the Donor -> Recipient control connection whenever no explicit [client] SSL
# certificates were configured, so the clone SST failed here with
# "ER_SECURE_TRANSPORT_REQUIRED". With the fix (--ssl-mode=PREFERRED) the Donor
# negotiates TLS with the Recipient (certificates are always available, either
# configured or auto-generated) and the SST succeeds.
#
# NOTE on connections: because the whole cluster runs with
# require_secure_transport=ON, every connection to a node must be secure. The
# MTR harness connects over a UNIX socket (a secure transport), so we force all
# galera_connect.inc connections to use the socket as well, and drive the SST
# manually instead of reusing galera_st_clean_slave.inc (which opens a hardcoded
# TCP connection that require_secure_transport would reject).
#
--source include/big_test.inc

--let $galera_use_socket_client_connection= 1
--source include/galera_cluster.inc

--connection node_1
--echo # Sanity check: the cluster enforces secure transport
SELECT @@global.require_secure_transport AS require_secure_transport;

--echo # Create data on node_1 before node_2 leaves the cluster
CREATE TABLE t1 (f1 INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1), (2), (3), (4), (5);

--echo # Shut node_2 down and wipe its data directory to force a full (clone) SST
--connection node_2
--source include/shutdown_mysqld.inc

--connection node_1
--let $wait_condition = SELECT VARIABLE_VALUE = 1 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'wsrep_cluster_size'
--source include/wait_condition.inc

--echo # Cleaning node_2 var directory ...
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data/mtr *
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data/performance_schema *
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data/test *
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data/mysql *
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data/sys *
--exec find $MYSQLTEST_VARDIR/mysqld.2/data -type f \! \( -name mysqld.my -o -name component_keyring_file.cnf \) -delete

--echo # Add more rows while node_2 is away, so the SST has to transfer them
INSERT INTO t1 VALUES (6), (7), (8), (9), (10);

--echo # Restart node_2 - this triggers a clone SST from node_1
--connection node_2
--source include/start_mysqld.inc

--let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'wsrep_cluster_size'
--source include/wait_condition.inc

--echo # node_2 must have received the full data set via clone SST
SELECT COUNT(*) AS count_on_node_2 FROM t1;
SELECT * FROM t1 ORDER BY f1;

--connection node_1
SELECT COUNT(*) AS count_on_node_1 FROM t1;
DROP TABLE t1;

# Install suppressions. Clone SST transfers only the InnoDB part, so node_2
# may log a "Failed to remove page file" warning during recovery.
--disable_query_log
--connection node_1
CALL mtr.add_suppression("Failed to remove page file");
--connection node_2
CALL mtr.add_suppression("Failed to remove page file");
--enable_query_log
