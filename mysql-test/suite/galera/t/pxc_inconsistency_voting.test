#
# This test ensures that TOI voting is deterministic across nodes even
# when lc_messages differs. At wsrep application protocol >= 7 the TOI
# vote buffer contains only " Error_code: NNNN;" (no locale-dependent
# message text), so nodes running with different lc_messages still vote
# on identical byte sequences without needing the recompute-by-error-code
# fallback in PXC's Galera library.
#
--source include/galera_cluster.inc

CREATE TABLE t1 (c1 INTEGER AUTO_INCREMENT PRIMARY KEY, c2 INTEGER);

# Modify the lc_messages setting to simulate different error message on node1
SET lc_messages = 'fr_FR';

--error ER_WRONG_AUTO_KEY
ALTER TABLE t1 MODIFY c2 BIGINT UNSIGNED NOT NULL AUTO_INCREMENT ;

# Both nodes must initiate the vote with the same error code
# (ER_WRONG_AUTO_KEY = 1075). Count is 2: node_1's own vote and
# node_2's vote, both logged on node_1.
--let $assert_text= Verify that both nodes vote on the same error code
--let $assert_select= initiates vote on .*:  Error_code: 1075;
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_count=2
--source include/assert_grep.inc

# The vote buffer must not carry the locale-dependent message text on
# either side — this is what makes voting deterministic across
# lc_messages settings.
--let $assert_text= Verify vote buffer carries no French message text
--let $assert_select= initiates vote on .* Un seul champ automatique
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_count=0
--source include/assert_grep.inc

--let $assert_text= Verify vote buffer carries no English message text
--let $assert_select= initiates vote on .* Incorrect table definition
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_count=0
--source include/assert_grep.inc

# Verify that cluster remains operational even when the above query failed with different error messages.
ALTER TABLE t1 MODIFY c2 BIGINT UNSIGNED NOT NULL;
INSERT INTO t1 (c2) VALUES (123123), (234234);
SELECT * FROM t1;
--assert(`SELECT COUNT(*) = 2 FROM t1`)

--connection node_2
SELECT * FROM t1;
--assert(`SELECT COUNT(*) = 2 FROM t1`)

# Suppressions
CALL mtr.add_suppression("Replica SQL: Error 'Incorrect table definition; there can be only one auto column and it must be defined as a key'");

# Cleanup
DROP TABLE t1;
