--source include/galera_cluster.inc

#
# This tests MyISAM tables in transactions. No MyISAM updates arrive on the slave, but InnoDB ones do.
#

SET SESSION wsrep_replicate_myisam=ON;
CREATE TABLE t1 (f1 INTEGER) ENGINE=InnoDB;
CREATE TABLE t2 (f1 INTEGER) ENGINE=MyISAM;
CREATE TABLE t3 (f1 INTEGER) ENGINE=MyISAM;
SET SESSION wsrep_replicate_myisam=OFF;

CREATE TRIGGER tr1 BEFORE INSERT ON t1 FOR EACH ROW INSERT INTO t3 VALUES (NEW.f1);

--disable_query_log
--let $enforce_gtid_consistency= `SELECT @@GLOBAL.enforce_gtid_consistency`
--enable_query_log

if ($enforce_gtid_consistency == ON)
{
  # With GTID consistency enforced, statements that update InnoDB and MyISAM in
  # the same statement/transaction are rejected (e.g. via the trigger above).
  # We get error: Statement violates GTID consistency: Updates to
  # non-transactional tables can only be done in either autocommitted
  # statements or single-statement transactions, and never in the same
  # statement as updates to transactional tables.
  SET AUTOCOMMIT=OFF;
  START TRANSACTION;
  --error 1785
  INSERT INTO t1 VALUES (1);
  ROLLBACK;
  SET AUTOCOMMIT=ON;

  --connection node_2
  SELECT COUNT(*) = 0 FROM t1;
  SELECT COUNT(*) = 0 FROM t2;
  SELECT COUNT(*) = 0 FROM t3;

  --connection node_1
  DROP TABLE t1, t2, t3;
  --exit
}

SET AUTOCOMMIT=OFF;
START TRANSACTION;
INSERT INTO t1 VALUES (1);
INSERT INTO t2 VALUES (1);
COMMIT;

--connection node_2
SELECT COUNT(*) = 1 FROM t1;
SELECT COUNT(*) = 0 FROM t2;
SELECT COUNT(*) = 0 FROM t3;

--connection node_1
START TRANSACTION;
INSERT INTO t1 VALUES (1);
INSERT INTO t2 VALUES (1);
ROLLBACK;

--connection node_2
SELECT COUNT(*) = 1 FROM t1;
SELECT COUNT(*) = 0 FROM t2;
SELECT COUNT(*) = 0 FROM t3;

DROP TABLE t1, t2, t3;
