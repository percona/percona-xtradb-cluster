#
# sql_generate_invisible_primary_key: cluster started with the variable ON.
#
# Every node starts with sql_generate_invisible_primary_key=ON (see the .cnf).
# This test walks the transitions available from that starting point and checks,
# on EVERY node, that the generated invisible primary key is present exactly
# where it should be and that all nodes agree.
#
# 1. Globals are ON. Sessions not touched.
#    PK-less table get my_row_id on all nodes.
# 2. SET GLOBAL to OFF on every node. Sessions not touched.
#    PXC-5140: the appliers session copy still say ON,
#    but originating session is OFF
# 3. Globals OFF everywhere, but the originating SESSION turns it back ON
# 4. Globals OFF everywhere, but the originating SESSION turns it back OFF
#
# The DDL in steps 2 and 3 runs on a fresh connection because an existing
# session keeps the value it copied from the global when it connected.
#

--source include/galera_cluster.inc

--echo #
--echo # 1. Globals are ON. Sessions not touched.
--echo #    PK-less table get my_row_id on all nodes.
--echo #

--connection node_1
SELECT @@global.sql_generate_invisible_primary_key;
--connection node_2
SELECT @@global.sql_generate_invisible_primary_key;

--connection node_1
CREATE TABLE t1 (id INT NOT NULL, c VARCHAR(100)) ENGINE=InnoDB;
CREATE TABLE t2 ENGINE=InnoDB AS SELECT 1 AS id;
CREATE TABLE t3 (id INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;

--echo # --- node_1 (originator) ---
SHOW CREATE TABLE t1;
SHOW CREATE TABLE t2;
SHOW CREATE TABLE t3;

--echo # --- node_2 (applier) ---
--connection node_2
--let $wait_condition = SELECT COUNT(*) = 3 FROM information_schema.tables WHERE table_schema = 'test' AND table_name IN ('t1','t2','t3')
--source include/wait_condition.inc
SHOW CREATE TABLE t1;
SHOW CREATE TABLE t2;
SHOW CREATE TABLE t3;

--echo # --- assert on every node, and that the nodes agree ---
--let $gipk_expected = 1
--let $gipk_table = t1
--source suite/galera/include/galera_gipk_assert.inc
--let $gipk_table = t2
--source suite/galera/include/galera_gipk_assert.inc
--let $gipk_expected = 0
--let $gipk_table = t3
--source suite/galera/include/galera_gipk_assert.inc

--connection node_1
DROP TABLE t1, t2, t3;

--echo #
--echo # 2. SET GLOBAL to OFF on every node. Sessions not touched.
--echo #    PXC-5140: the appliers session copy still say ON,
--echo #    but originating session is OFF
--echo #

--connection node_1
SET GLOBAL sql_generate_invisible_primary_key = OFF;
--connection node_2
SET GLOBAL sql_generate_invisible_primary_key = OFF;

--connect(node_1a, 127.0.0.1, root, , test, $NODE_MYPORT_1)
--connection node_1a
SELECT @@session.sql_generate_invisible_primary_key;
CREATE TABLE t4 (id INT NOT NULL, c VARCHAR(100)) ENGINE=InnoDB;
CREATE TABLE t5 ENGINE=InnoDB AS SELECT 1 AS id;

--echo # --- node_1 (originator) ---
--connection node_1
SHOW CREATE TABLE t4;
SHOW CREATE TABLE t5;

--echo # --- node_2 (applier) ---
--connection node_2
--let $wait_condition = SELECT COUNT(*) = 2 FROM information_schema.tables WHERE table_schema = 'test' AND table_name IN ('t4','t5')
--source include/wait_condition.inc
SHOW CREATE TABLE t4;
SHOW CREATE TABLE t5;

--echo # --- assert on every node, and that the nodes agree ---
--let $gipk_expected = 0
--let $gipk_table = t4
--source suite/galera/include/galera_gipk_assert.inc
--let $gipk_table = t5
--source suite/galera/include/galera_gipk_assert.inc

--connection node_1a
DROP TABLE t4, t5;

--echo #
--echo # 3. Globals OFF everywhere, but the originating SESSION turns it back ON
--echo #

--connection node_1a
SET SESSION sql_generate_invisible_primary_key = ON;
CREATE TABLE t6 (id INT NOT NULL, c VARCHAR(100)) ENGINE=InnoDB;
CREATE TABLE t7 ENGINE=InnoDB AS SELECT 1 AS id;
SET SESSION sql_generate_invisible_primary_key = DEFAULT;

--echo # --- node_1 (originator) ---
--connection node_1
SHOW CREATE TABLE t6;
SHOW CREATE TABLE t7;

--echo # --- node_2 (applier, global OFF) ---
--connection node_2
--let $wait_condition = SELECT COUNT(*) = 2 FROM information_schema.tables WHERE table_schema = 'test' AND table_name IN ('t6','t7')
--source include/wait_condition.inc
SHOW CREATE TABLE t6;
SHOW CREATE TABLE t7;

--echo # --- assert on every node, and that the nodes agree ---
--let $gipk_expected = 1
--let $gipk_table = t6
--source suite/galera/include/galera_gipk_assert.inc
--let $gipk_table = t7
--source suite/galera/include/galera_gipk_assert.inc

--connection node_1a
DROP TABLE t6, t7;

--echo #
--echo # 4. Globals OFF everywhere, but the originating SESSION turns it back OFF
--echo #

--connection node_1a
SET SESSION sql_generate_invisible_primary_key = OFF;
CREATE TABLE t8 (id INT NOT NULL, c VARCHAR(100)) ENGINE=InnoDB;
CREATE TABLE t9 ENGINE=InnoDB AS SELECT 1 AS id;
SET SESSION sql_generate_invisible_primary_key = DEFAULT;

--echo # --- node_1 (originator) ---
--connection node_1
SHOW CREATE TABLE t8;
SHOW CREATE TABLE t9;

--echo # --- node_2 (applier, global OFF) ---
--connection node_2
--let $wait_condition = SELECT COUNT(*) = 2 FROM information_schema.tables WHERE table_schema = 'test' AND table_name IN ('t8','t9')
--source include/wait_condition.inc
SHOW CREATE TABLE t8;
SHOW CREATE TABLE t9;

--echo # --- assert on every node, and that the nodes agree ---
--let $gipk_expected = 0
--let $gipk_table = t8
--source suite/galera/include/galera_gipk_assert.inc
--let $gipk_table = t9
--source suite/galera/include/galera_gipk_assert.inc

--connection node_1a
DROP TABLE t8, t9;

--echo #
--echo # Cleanup: restore the startup value
--echo #
--disconnect node_1a
--connection node_1
SET GLOBAL sql_generate_invisible_primary_key = ON;
--connection node_2
SET GLOBAL sql_generate_invisible_primary_key = ON;
