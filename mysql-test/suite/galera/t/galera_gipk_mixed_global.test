#
# PXC-5140: the *originating* node decides whether an invisible primary key is
#           generated, even when the nodes disagree on the global setting.
#
# node_1 runs with sql_generate_invisible_primary_key=ON, node_2 with OFF.
# Whichever node issues the CREATE TABLE decides the resulting definition, and
# both nodes must end up with an identical table.
#

--source include/galera_cluster.inc

# A statement that GIPK mode rejects is replicated under TOI before it is
# executed, so it now fails identically on every node (Galera's error voting
# agrees and the nodes stay up). That is the point of the fix - before it, the
# applier could silently succeed where the originator failed - but it does log
# the apply error on the remote node.
--connection node_1
call mtr.add_suppression("Replica SQL: Error .*existing primary key drop without adding a new primary key.*");
call mtr.add_suppression("Replica SQL: Error .*generating invisible primary key for the partitioned tables.*");
--connection node_2
call mtr.add_suppression("Replica SQL: Error .*existing primary key drop without adding a new primary key.*");
call mtr.add_suppression("Replica SQL: Error .*generating invisible primary key for the partitioned tables.*");

--connection node_1
SELECT @@global.sql_generate_invisible_primary_key;
--connection node_2
SELECT @@global.sql_generate_invisible_primary_key;

--echo #
--echo # CREATE TABLE issued on node_1 (GIPK ON) -> both nodes get my_row_id
--echo #
--connection node_1
CREATE TABLE t1 (id INT NOT NULL, c VARCHAR(100)) ENGINE=InnoDB;
CREATE TABLE t2 ENGINE=InnoDB AS SELECT 1 AS id;

--echo # --- node_1 ---
SHOW CREATE TABLE t1;
SHOW CREATE TABLE t2;

--echo # --- node_2 ---
--connection node_2
--let $wait_condition = SELECT COUNT(*) = 2 FROM information_schema.tables WHERE table_schema = 'test' AND table_name IN ('t1','t2')
--source include/wait_condition.inc
SHOW CREATE TABLE t1;
SHOW CREATE TABLE t2;

--echo #
--echo # CREATE TABLE issued on node_2 (GIPK OFF) -> neither node gets my_row_id
--echo #
--connection node_2
CREATE TABLE t3 (id INT NOT NULL, c VARCHAR(100)) ENGINE=InnoDB;
CREATE TABLE t4 ENGINE=InnoDB AS SELECT 1 AS id;

--echo # --- node_2 ---
SHOW CREATE TABLE t3;
SHOW CREATE TABLE t4;

--echo # --- node_1 ---
--connection node_1
--let $wait_condition = SELECT COUNT(*) = 2 FROM information_schema.tables WHERE table_schema = 'test' AND table_name IN ('t3','t4')
--source include/wait_condition.inc
SHOW CREATE TABLE t3;
SHOW CREATE TABLE t4;

--echo #
--echo # ALTER TABLE ... DROP PRIMARY KEY must be accepted or rejected identically
--echo # on both nodes. GIPK mode rejects it (check_primary_key_alter_restrictions),
--echo # so a node applying it under a different setting than the originator would
--echo # fail the write set instead of merely diverging.
--echo #
--echo # From node_2 (GIPK OFF) - allowed, and must apply cleanly on node_1 (GIPK ON)
--connection node_2
CREATE TABLE t5 (id INT NOT NULL PRIMARY KEY, c VARCHAR(100)) ENGINE=InnoDB;
ALTER TABLE t5 DROP PRIMARY KEY;
SHOW CREATE TABLE t5;

--connection node_1
# Wait for the table to exist first: the "no PRIMARY index" predicate on its own
# is trivially true before t5 arrives, so it would synchronise nothing.
--let $wait_condition = SELECT COUNT(*) = 1 FROM information_schema.tables WHERE table_schema = 'test' AND table_name = 't5'
--source include/wait_condition.inc
--let $wait_condition = SELECT COUNT(*) = 0 FROM information_schema.statistics WHERE table_schema = 'test' AND table_name = 't5' AND index_name = 'PRIMARY'
--source include/wait_condition.inc
SHOW CREATE TABLE t5;

--echo # From node_1 (GIPK ON) - rejected. DDL is replicated under TOI *before* it
--echo # executes, so the write set does reach node_2 and fails there too, with the
--echo # same error (hence the suppressions above). Both nodes keep the primary key.
--connection node_1
CREATE TABLE t6 (id INT NOT NULL PRIMARY KEY, c VARCHAR(100)) ENGINE=InnoDB;
--error ER_NOT_SUPPORTED_YET
ALTER TABLE t6 DROP PRIMARY KEY;
SHOW CREATE TABLE t6;

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 1 FROM information_schema.tables WHERE table_schema = 'test' AND table_name = 't6'
--source include/wait_condition.inc
SHOW CREATE TABLE t6;

--echo #
--echo # A PK-less partitioned table under GIPK ON is rejected - and must be
--echo # rejected on every node, not only on the originator.
--echo #
--connection node_1
--error ER_NOT_SUPPORTED_YET
CREATE TABLE t7 (id INT NOT NULL) ENGINE=InnoDB PARTITION BY HASH(id) PARTITIONS 2;
SELECT COUNT(*) AS t7_on_node_1 FROM information_schema.tables
  WHERE table_schema = 'test' AND table_name = 't7';

--echo # Anchor the negative check: replicate a statement that *does* succeed and
--echo # wait for it on node_2, so "t7 absent" cannot merely mean "not arrived yet".
--connection node_1
CREATE TABLE t7_anchor (id INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 1 FROM information_schema.tables WHERE table_schema = 'test' AND table_name = 't7_anchor'
--source include/wait_condition.inc
SELECT COUNT(*) AS t7_on_node_2 FROM information_schema.tables
  WHERE table_schema = 'test' AND table_name = 't7';

--echo #
--echo # CREATE TABLE ... LIKE <temporary table> keeps working: it is the other
--echo # user of the write-set pre-query channel.
--echo #
--connection node_1
CREATE TEMPORARY TABLE t8_tmp (id INT NOT NULL, c VARCHAR(100)) ENGINE=InnoDB;
CREATE TABLE t8 LIKE t8_tmp;
SHOW CREATE TABLE t8;

--connection node_2
--let $wait_condition = SELECT COUNT(*) = 1 FROM information_schema.tables WHERE table_schema = 'test' AND table_name = 't8'
--source include/wait_condition.inc
SHOW CREATE TABLE t8;

--echo #
--echo # The same must hold under wsrep_OSU_method=NBO: ALTER / CREATE INDEX /
--echo # DROP INDEX are exactly the NBO-eligible statements, so every NBO write
--echo # set now carries the originator's setting and applies it on the NBO
--echo # worker thread.
--echo #
--connection node_2
# CREATE TABLE is not NBO-eligible (wsrep_can_run_in_nbo() admits only ALTER
# TABLE and CREATE/DROP INDEX), so create the table before switching methods.
CREATE TABLE t9 (id INT NOT NULL PRIMARY KEY, c VARCHAR(100)) ENGINE=InnoDB;
SET SESSION wsrep_OSU_method = NBO;
ALTER TABLE t9 DROP PRIMARY KEY;
SET SESSION wsrep_OSU_method = DEFAULT;
SHOW CREATE TABLE t9;

--connection node_1
--let $wait_condition = SELECT COUNT(*) = 1 FROM information_schema.tables WHERE table_schema = 'test' AND table_name = 't9'
--source include/wait_condition.inc
--let $wait_condition = SELECT COUNT(*) = 0 FROM information_schema.statistics WHERE table_schema = 'test' AND table_name = 't9' AND index_name = 'PRIMARY'
--source include/wait_condition.inc
SHOW CREATE TABLE t9;

--connection node_1
DROP TEMPORARY TABLE t8_tmp;
DROP TABLE t5, t6, t7_anchor, t8, t9;

--connection node_1
DROP TABLE t1, t2, t3, t4;
