################################################################################
#
# This test proves that when wsrep_desync_pause_retry_timeout > 0, FTWRL
# (with backup lock) retries try_desync_and_pause every 100ms.
# If the queue drains in wsrep_desync_pause_retry_timeout seconds,
# try_desync_and_pause succeeds and FTWRL completes else FTRWL fails.
#
# 1. Setup.
# 2. Test with wsrep_desync_pause_retry_timeout FTWRL retries
#    try_desync_and_pause instead of failing.
# 3. Block applier using sync point apply_monitor_slave_enter_sync.
#    for transaction queue.
#    Galera queue we cannot distinguish DDL and DML so FTRWL waits for DML.
# 4. Test LOCK INSTANCE FOR BACKUP and FTRWL do not fail.
# 5. Assert row exists.
# 6. Test with wsrep_desync_pause_retry_timeout set to -
#     FTWRL fails due to try_desync_and_pause failure.
# 7. Block applier using sync point apply_monitor_slave_enter_sync.
#    for transaction queue.
# 8. Test LOCK INSTANCE FOR BACKUP passes and FTRWL fails.
# 9. Assert row exists.
# 10. Timeout scenario: timeout 5 sec, block applier, FTWRL, wait 10 sec,
#     unblock DML, FTWRL should fail (timeout).
# 11. Cleanup.
################################################################################
--source include/galera_cluster.inc
--source include/have_debug_sync.inc
--source suite/galera/include/galera_have_debug_sync.inc

--echo #
--echo # 1. Setup.
--echo #

# Expected while FTWRL retries try_desync_and_pause until the apply queue drains.
--connection node_2
--disable_query_log
call mtr.add_suppression("Apply monitor not drained");
call mtr.add_suppression("Commit monitor not drained");
call mtr.add_suppression("GCS desync failed:");
call mtr.add_suppression("GCS desync returned seqno");
call mtr.add_suppression("Invalid local_seqno");
--enable_query_log

--connect node_2a, 127.0.0.1, root, , test, $NODE_MYPORT_2

--connection node_1
CREATE DATABASE IF NOT EXISTS db1;
CREATE TABLE IF NOT EXISTS db1.t1 (id INT PRIMARY KEY, a INT);

--echo #
--echo # 2. Test with wsrep_desync_pause_retry_timeout FTWRL retries
--echo #    try_desync_and_pause instead of failing.
--echo #

--connection node_2
SET @wsrep_desync_pause_retry_timeout_save= @@GLOBAL.wsrep_desync_pause_retry_timeout;
SET GLOBAL wsrep_desync_pause_retry_timeout = 3600;

--echo #
--echo # 3. Block applier using sync point apply_monitor_slave_enter_sync.
--echo #    for transaction queue.
--echo #    Galera queue we cannot distinguish DDL and DML so FTRWL waits for DML.
--echo #

--connection node_2
--let $galera_sync_point = apply_monitor_slave_enter_sync
--source include/galera_set_sync_point.inc

--connection node_1
INSERT INTO db1.t1 VALUES (1, 1);

--connection node_2
SET SESSION wsrep_sync_wait = 0;

# Wait until applier has blocked
--source include/galera_wait_sync_point.inc

--echo #
--echo # 4. Test LOCK INSTANCE FOR BACKUP and FTRWL do not fail.
--echo #

--connection node_2a
LOCK INSTANCE FOR BACKUP;
--send FLUSH TABLES WITH READ LOCK

--connection node_2

--let $wait_condition = SELECT COUNT(*) >= 1 FROM performance_schema.processlist WHERE info LIKE '%FLUSH TABLES WITH READ LOCK%'
--source include/wait_condition.inc

# Now allow applier to continue for the queue to drain and FTRWL waits for pipe drain and pass.

--source include/galera_clear_sync_point.inc
--source include/galera_signal_sync_point.inc

# FTRWL does not fail.
--connection node_2a
--reap

--connection node_2a
UNLOCK TABLES;
UNLOCK INSTANCE;

--echo #
--echo # 5. Assert row exists.
--echo #

--connection node_1
--let $assert_text = Row exists in node-1
--let $assert_cond = COUNT(*) = 1 FROM db1.t1 WHERE id = 1
--source include/assert.inc

--connection node_2
--let $wait_condition= SELECT COUNT(*)=1 FROM db1.t1 WHERE id = 1
--source include/wait_condition.inc

--echo #
--echo # 6. Test with wsrep_desync_pause_retry_timeout set to -
--echo #     FTWRL fails due to try_desync_and_pause failure.
--echo #

--connection node_2
SET GLOBAL wsrep_desync_pause_retry_timeout = 0;

--echo #
--echo # 7. Block applier using sync point apply_monitor_slave_enter_sync.
--echo #    for transaction queue.
--echo #

--connection node_2
--let $galera_sync_point = apply_monitor_slave_enter_sync
--source include/galera_set_sync_point.inc

--connection node_1
INSERT INTO db1.t1 VALUES (2, 2);

--connection node_2
--source include/galera_wait_sync_point.inc

--echo #
--echo # 8. Test LOCK INSTANCE FOR BACKUP passes and FTRWL fails.
--echo #

--connection node_2a
LOCK INSTANCE FOR BACKUP;

--error ER_QUERY_INTERRUPTED
FLUSH TABLES WITH READ LOCK;

--source include/galera_clear_sync_point.inc
--source include/galera_signal_sync_point.inc

--connection node_2a
UNLOCK TABLES;
UNLOCK INSTANCE;

--echo #
--echo # 9. Assert row exists.
--echo #

--connection node_1
--let $assert_text = Row exists in node-1
--let $assert_cond = COUNT(*) = 1 FROM db1.t1 WHERE id = 2
--source include/assert.inc

--connection node_2
--let $wait_condition= SELECT COUNT(*)=1 FROM db1.t1 WHERE id = 2
--source include/wait_condition.inc

--echo #
--echo # 10. Timeout scenario: timeout 5 sec, block applier, FTWRL, wait 10 sec,
--echo #     unblock DML, FTWRL should fail (timeout).
--echo #

--connection node_2
SET GLOBAL wsrep_desync_pause_retry_timeout = 5;

--connection node_2
--let $galera_sync_point = apply_monitor_slave_enter_sync
--source include/galera_set_sync_point.inc

--connection node_1
INSERT INTO db1.t1 VALUES (3, 3);

--connection node_2
--source include/galera_wait_sync_point.inc

--connection node_2a
LOCK INSTANCE FOR BACKUP;
--send FLUSH TABLES WITH READ LOCK

--connection node_2
--let $wait_condition = SELECT COUNT(*) >= 1 FROM performance_schema.processlist WHERE info LIKE '%FLUSH TABLES WITH READ LOCK%'
--source include/wait_condition.inc

# Wait 10 sec so 5 sec timeout expires; FTWRL will fail with ER_QUERY_INTERRUPTED.
--sleep 10

--source include/galera_clear_sync_point.inc
--source include/galera_signal_sync_point.inc

--connection node_2a
--error ER_QUERY_INTERRUPTED
--reap

--connection node_2a
UNLOCK TABLES;
UNLOCK INSTANCE;

--connection node_1
--let $assert_text = Row exists in node-1 after timeout scenario
--let $assert_cond = COUNT(*) = 1 FROM db1.t1 WHERE id = 3
--source include/assert.inc

--connection node_2
--let $wait_condition= SELECT COUNT(*)=1 FROM db1.t1 WHERE id = 3
--source include/wait_condition.inc

--echo #
--echo # 11. Cleanup.
--echo #

--disconnect node_2a

--connection node_2
SET @@GLOBAL.wsrep_desync_pause_retry_timeout = @wsrep_desync_pause_retry_timeout_save;

--connection node_1
DROP DATABASE db1;
