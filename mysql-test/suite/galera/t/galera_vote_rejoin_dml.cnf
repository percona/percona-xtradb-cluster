!include ../galera_4nodes.cnf

[mysqld]
wsrep-ignore-apply-errors=0

[ENV]
galera_cluster_size=4

# Increase the SST timeout due to mysql_upgrade
# This is needed here since we are staring up 4 nodes and there
# are 3 SSTs running at the same time
[sst]
sst-initial-timeout=300


[mysqld.1]
wsrep_provider_options='base_port=@mysqld.1.#galera_port;gmcast.segment=1;@ENV.WSREP_PROVIDER_TIMEOUTS'

[mysqld.2]
wsrep_provider_options='base_port=@mysqld.2.#galera_port;gmcast.segment=1;@ENV.WSREP_PROVIDER_TIMEOUTS'

[mysqld.3]
wsrep_provider_options='base_port=@mysqld.3.#galera_port;gmcast.segment=2;@ENV.WSREP_PROVIDER_TIMEOUTS'

[mysqld.4]
wsrep_provider_options='base_port=@mysqld.4.#galera_port;gmcast.segment=2;@ENV.WSREP_PROVIDER_TIMEOUTS'

