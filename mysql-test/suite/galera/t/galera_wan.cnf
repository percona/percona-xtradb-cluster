!include ../galera_4nodes.cnf

[mysqld.1]
wsrep_provider_options='base_port=@mysqld.1.#galera_port;gmcast.segment=1;@ENV.WSREP_PROVIDER_TIMEOUTS'

[mysqld.2]
wsrep_provider_options='base_port=@mysqld.2.#galera_port;gmcast.segment=1;@ENV.WSREP_PROVIDER_TIMEOUTS'

[mysqld.3]
wsrep_provider_options='base_port=@mysqld.3.#galera_port;gmcast.segment=2;@ENV.WSREP_PROVIDER_TIMEOUTS'

[mysqld.4]
wsrep_provider_options='base_port=@mysqld.4.#galera_port;gmcast.segment=3;@ENV.WSREP_PROVIDER_TIMEOUTS'

