Connected to: node_1
SELECT * FROM shop.customer ORDER BY x;
x	y	z
Connected to: node_2
SELECT * FROM shop.customer ORDER BY x;
x	y	z
##### END #####

DROP TABLE shop.customer;
CREATE TABLE shop.customer(
`ID` integer not null PRIMARY KEY,
`NAME` varchar(50) not null,
`ADDRESS` varchar(255));

##### START #####
include/assert_table_are_same_in_cluster.inc [No rows exist due to no commit.] [node_1: SELECT test_table_access_driver("INSERT-CUSTOMER-NO-COMMIT");]
SELECT test_table_access_driver("INSERT-CUSTOMER-NO-COMMIT");;
test_table_access_driver("INSERT-CUSTOMER-NO-COMMIT")
OK, but forgot to commit
Connected to: node_1
SELECT * FROM shop.customer ORDER BY ID;
ID	NAME	ADDRESS
Connected to: node_2
SELECT * FROM shop.customer ORDER BY ID;
ID	NAME	ADDRESS
##### END #####


##### START #####
include/assert_table_are_same_in_cluster.inc [No rows exist due to rollback.] [node_1: SELECT test_table_access_driver("INSERT-CUSTOMER-ROLLBACK");]
