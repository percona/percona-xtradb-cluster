#####################################################################
#####          Replication across cluster is ON                 #####
#####################################################################
INSTALL COMPONENT 'file://component_test_table_access_galera';

"Set replication across cluster ON"
SELECT test_table_access_driver("REPLICATE_TRANSACTIONS_IN_GALERA");
test_table_access_driver("REPLICATE_TRANSACTIONS_IN_GALERA")
NULL

SELECT test_table_access_driver("unknown test");
test_table_access_driver("unknown test")
NULL

# Below will fail since tables do not exist.
SELECT test_table_access_driver("INSERT-CUSTOMER-STRESS-1");
test_table_access_driver("INSERT-CUSTOMER-STRESS-1")
create() failed
SELECT test_table_access_driver("INSERT-CUSTOMER-STRESS-2");
test_table_access_driver("INSERT-CUSTOMER-STRESS-2")
get() failed
SELECT test_table_access_driver("INSERT-CUSTOMER");
test_table_access_driver("INSERT-CUSTOMER")
get() failed
include/assert.inc ['Tables do not exist so above statements failed']
CREATE SCHEMA shop;
SELECT test_table_access_driver("INSERT-CUSTOMER");
test_table_access_driver("INSERT-CUSTOMER")
get() failed
include/assert.inc ['Tables do not exist so above statements failed']
CREATE TABLE shop.customer (x integer);

##### START #####
include/assert_table_are_same_in_cluster.inc [Different schema expect failure] [node_1: ]
Connected to: node_1
SELECT * FROM shop.customer ORDER BY x;
x
Connected to: node_2
SELECT * FROM shop.customer ORDER BY x;
x
##### END #####


