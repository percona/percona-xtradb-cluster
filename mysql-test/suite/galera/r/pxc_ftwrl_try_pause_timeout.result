#
# 1. Default value of wsrep_desync_pause_retry_timeout is 30.
#
SET @wsrep_desync_pause_retry_timeout_save= @@GLOBAL.wsrep_desync_pause_retry_timeout;
SELECT @@GLOBAL.wsrep_desync_pause_retry_timeout;
@@GLOBAL.wsrep_desync_pause_retry_timeout
30
#
# 2. Test some valid values for wsrep_desync_pause_retry_timeout.
#
SET GLOBAL wsrep_desync_pause_retry_timeout = 0;
SELECT @@GLOBAL.wsrep_desync_pause_retry_timeout;
@@GLOBAL.wsrep_desync_pause_retry_timeout
0
SET GLOBAL wsrep_desync_pause_retry_timeout = 5;
SELECT @@GLOBAL.wsrep_desync_pause_retry_timeout;
@@GLOBAL.wsrep_desync_pause_retry_timeout
5
SET GLOBAL wsrep_desync_pause_retry_timeout = 31536000;
SELECT @@GLOBAL.wsrep_desync_pause_retry_timeout;
@@GLOBAL.wsrep_desync_pause_retry_timeout
31536000
#
# 3. Test some invalid values for wsrep_desync_pause_retry_timeout.
#
SET GLOBAL wsrep_desync_pause_retry_timeout = -1;
Warnings:
Warning	1292	Truncated incorrect wsrep_desync_pause_retry_timeout value: '-1'
SELECT @@GLOBAL.wsrep_desync_pause_retry_timeout;
@@GLOBAL.wsrep_desync_pause_retry_timeout
0
SET GLOBAL wsrep_desync_pause_retry_timeout = 31536001;
Warnings:
Warning	1292	Truncated incorrect wsrep_desync_pause_retry_timeout value: '31536001'
SELECT @@GLOBAL.wsrep_desync_pause_retry_timeout;
@@GLOBAL.wsrep_desync_pause_retry_timeout
31536000
SET GLOBAL wsrep_desync_pause_retry_timeout = 'A';
ERROR 42000: Incorrect argument type to variable 'wsrep_desync_pause_retry_timeout'
SELECT @@GLOBAL.wsrep_desync_pause_retry_timeout;
@@GLOBAL.wsrep_desync_pause_retry_timeout
31536000
SET GLOBAL wsrep_desync_pause_retry_timeout = A;
ERROR 42000: Incorrect argument type to variable 'wsrep_desync_pause_retry_timeout'
SELECT @@GLOBAL.wsrep_desync_pause_retry_timeout;
@@GLOBAL.wsrep_desync_pause_retry_timeout
31536000
#
# 4. Restore.
#
SET @@GLOBAL.wsrep_desync_pause_retry_timeout = @wsrep_desync_pause_retry_timeout_save;
SELECT @@GLOBAL.wsrep_desync_pause_retry_timeout;
@@GLOBAL.wsrep_desync_pause_retry_timeout
30
