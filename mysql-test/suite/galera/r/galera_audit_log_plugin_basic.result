#
# 1. Install audit_log PLUGIN on ALL nodes
#
call mtr.add_suppression("Plugin audit_log_filter reported: 'Failed to get an opened audit_log_filter table");
call mtr.add_suppression("Plugin audit_log_filter reported: 'Failed to load filtering rules");
# Create a database for audit testing
CREATE DATABASE audit_testing;
call mtr.add_suppression("Plugin audit_log_filter reported: 'Failed to get an opened audit_log_filter table");
call mtr.add_suppression("Plugin audit_log_filter reported: 'Failed to load filtering rules");
# Setup audit plugin on node 2
CREATE TABLE t1 (c1 INT);
CREATE TABLE t2 (c2 INT);
INSERT INTO t1 VALUES (1);
INSERT INTO t2 VALUES (1);
# Create users for testing
# user1: will be used to set audit rules.
CREATE USER 'user1'@'localhost' IDENTIFIED BY '111';
GRANT AUDIT_ADMIN ON *.* to 'user1'@'localhost';
# user2: has SYSTEM_USER and AUDIT_ABORT_EXEMPT privileges to test exemption.
CREATE USER 'user2'@'localhost' IDENTIFIED BY '222';
GRANT SYSTEM_USER ON *.* to 'user2'@'localhost';
GRANT AUDIT_ABORT_EXEMPT ON *.* to 'user2'@'localhost';
# Open new connections for the created users
#
# 2. Set up a filter and verify filter replication and filter working on all nodes
# Set the filter and verify it's replicated to all nodes.

##### START #####
include/assert_table_are_same_in_cluster.inc [audit_log_filter_set_filter is replicated.] [node_1: SELECT audit_log_filter_set_filter('table_readonly', '{
"filter": {
"class": {
"name": "table_access",
"event": {
"name": ["insert", "update", "delete"],
"abort": true
}
}
}
}');]
SELECT audit_log_filter_set_filter('table_readonly', '{
"filter": {
"class": {
"name": "table_access",
"event": {
"name": ["insert", "update", "delete"],
"abort": true
}
}
}
}');;
audit_log_filter_set_filter('table_readonly', '{
"filter": {
"class": {
"name": "table_access",
"event": {
"name": ["insert", "update", "delete"],
"abort": true
}
}
}
}')
OK
Connected to: node_1
SELECT * FROM audit_testing.audit_log_filter ORDER BY NAME;
filter_id	name	filter
1	table_readonly	{"filter": {"class": {"name": "table_access", "event": {"name": ["insert", "update", "delete"], "abort": true}}}}
Connected to: node_2
SELECT * FROM audit_testing.audit_log_filter ORDER BY NAME;
filter_id	name	filter
1	table_readonly	{"filter": {"class": {"name": "table_access", "event": {"name": ["insert", "update", "delete"], "abort": true}}}}
##### END #####

# Set the filter based on user and verify it's replicated to all nodes.

##### START #####
include/assert_table_are_same_in_cluster.inc [audit_log_filter_set_user is replicated.] [node_2: SELECT audit_log_filter_set_user('%', 'table_readonly');]
SELECT audit_log_filter_set_user('%', 'table_readonly');;
audit_log_filter_set_user('%', 'table_readonly')
OK
Connected to: node_1
SELECT * FROM audit_testing.audit_log_user ORDER BY FILTERNAME;
username	userhost	filtername
%	%	table_readonly
Connected to: node_2
SELECT * FROM audit_testing.audit_log_user ORDER BY FILTERNAME;
username	userhost	filtername
%	%	table_readonly
##### END #####

# Verify that INSERT statements are aborted on all nodes.
SELECT audit_log_filter_flush();
audit_log_filter_flush()
OK

Executing statement on: node_1
INSERT INTO t1 VALUES (2);;
ERROR HY000: Aborted by Audit API ('MYSQL_AUDIT_TABLE_ACCESS_INSERT';1).
SELECT audit_log_filter_flush();
audit_log_filter_flush()
OK

Executing statement on: node_2
INSERT INTO t1 VALUES (2);;
ERROR HY000: Aborted by Audit API ('MYSQL_AUDIT_TABLE_ACCESS_INSERT';1).
SELECT audit_log_filter_flush();
audit_log_filter_flush()
OK

Executing statement on: node_1
INSERT INTO t2 VALUES (2);;
ERROR HY000: Aborted by Audit API ('MYSQL_AUDIT_TABLE_ACCESS_INSERT';1).
SELECT audit_log_filter_flush();
audit_log_filter_flush()
OK

Executing statement on: node_2
INSERT INTO t2 VALUES (2);;
ERROR HY000: Aborted by Audit API ('MYSQL_AUDIT_TABLE_ACCESS_INSERT';1).
# Verify that UPDATE statements are aborted on all nodes.
SELECT audit_log_filter_flush();
audit_log_filter_flush()
OK

Executing statement on: node_1
UPDATE t1 SET c1 = 3 WHERE c1 = 2;;
ERROR HY000: Aborted by Audit API ('MYSQL_AUDIT_TABLE_ACCESS_UPDATE';1).
SELECT audit_log_filter_flush();
audit_log_filter_flush()
OK

Executing statement on: node_2
UPDATE t1 SET c1 = 3 WHERE c1 = 2;;
ERROR HY000: Aborted by Audit API ('MYSQL_AUDIT_TABLE_ACCESS_UPDATE';1).
SELECT audit_log_filter_flush();
audit_log_filter_flush()
OK

Executing statement on: node_1
UPDATE t2 SET c2 = 3 WHERE c2 = 2;;
ERROR HY000: Aborted by Audit API ('MYSQL_AUDIT_TABLE_ACCESS_UPDATE';1).
SELECT audit_log_filter_flush();
audit_log_filter_flush()
OK

Executing statement on: node_2
UPDATE t2 SET c2 = 3 WHERE c2 = 2;;
ERROR HY000: Aborted by Audit API ('MYSQL_AUDIT_TABLE_ACCESS_UPDATE';1).
# Verify that DELETE statements are aborted on all nodes.
SELECT audit_log_filter_flush();
audit_log_filter_flush()
OK

Executing statement on: node_1
DELETE FROM t1 WHERE c1 = 1;;
ERROR HY000: Aborted by Audit API ('MYSQL_AUDIT_TABLE_ACCESS_DELETE';1).
SELECT audit_log_filter_flush();
audit_log_filter_flush()
OK

Executing statement on: node_2
DELETE FROM t1 WHERE c1 = 1;;
ERROR HY000: Aborted by Audit API ('MYSQL_AUDIT_TABLE_ACCESS_DELETE';1).
SELECT audit_log_filter_flush();
audit_log_filter_flush()
OK

Executing statement on: node_1
DELETE FROM t2 WHERE c2 = 1;;
ERROR HY000: Aborted by Audit API ('MYSQL_AUDIT_TABLE_ACCESS_DELETE';1).
SELECT audit_log_filter_flush();
audit_log_filter_flush()
OK

Executing statement on: node_2
DELETE FROM t2 WHERE c2 = 1;;
ERROR HY000: Aborted by Audit API ('MYSQL_AUDIT_TABLE_ACCESS_DELETE';1).
# Check table contents to ensure no changes were made.
SELECT * FROM t1;
c1
1
SELECT * FROM t2;
c2
1
