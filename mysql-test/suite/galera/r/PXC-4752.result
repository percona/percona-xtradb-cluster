CREATE TABLE t1 (f1 INTEGER PRIMARY KEY) ENGINE=InnoDB;
SELECT @@wsrep_applier_threads;
@@wsrep_applier_threads
4
SET SESSION wsrep_sync_wait = 0;
SET SESSION wsrep_sync_wait = 0;
SET GLOBAL DEBUG = "d,sync.wsrep_apply_cb";
#
# 1. A single write set held inside an applier thread.
#    It has been received and is provably not applied yet, so it must be
#    reported even though the GCS receive FIFO is empty.
#
INSERT INTO t1 VALUES (1);
SET SESSION DEBUG_SYNC = "now WAIT_FOR sync.wsrep_apply_cb_reached";
wsrep_local_recv_queue >= 1 : 1
#
# 2. Six more write sets. Every applier thread is now busy, so the rest
#    pile up in the FIFO. All seven have been received and none applied.
#
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (3);
INSERT INTO t1 VALUES (4);
INSERT INTO t1 VALUES (5);
INSERT INTO t1 VALUES (6);
INSERT INTO t1 VALUES (7);
wsrep_local_recv_queue >= 7 : 1
# The high watermark is derived from the same accounting, so it must have
# recorded at least this backlog too. Asserted as >= to stay independent
# of any queueing that happened while the cluster was starting up.
wsrep_local_recv_queue_max >= 7 : 1
# FLUSH STATUS resets the watermarks to the current length. Nothing can
# drain while the appliers are parked, so the low watermark, which was 0,
# must now be at least 7.
# wsrep_on=OFF keeps FLUSH STATUS out of TOI, which would otherwise wait
# behind the parked appliers. The provider statistics are still reset,
# because refresh_status() checks the global wsrep_on, not the session one.
SET SESSION wsrep_on = OFF;
FLUSH NO_WRITE_TO_BINLOG STATUS;
SET SESSION wsrep_on = ON;
wsrep_local_recv_queue_min >= 7 after FLUSH STATUS : 1
#
# 3. Release the appliers. Everything applies and the queue drains back
#    to zero - this is the guard against the in-flight counter leaking.
#
SET GLOBAL DEBUG = "";
SET DEBUG_SYNC = "now SIGNAL signal.wsrep_apply_cb";
SELECT COUNT(*) AS rows_applied FROM t1;
rows_applied
7
wsrep_local_recv_queue = 0
# The low watermark follows the drain down to zero.
wsrep_local_recv_queue_min = 0
SET DEBUG_SYNC = "reset";
SET SESSION wsrep_sync_wait = DEFAULT;
DROP TABLE t1;
