#
# CREATE TABLE issued on node_1 (GIPK ON) -> both nodes get my_row_id
#
CREATE TABLE t1 (id INT NOT NULL, c VARCHAR(100)) ENGINE=InnoDB;
CREATE TABLE t2 ENGINE=InnoDB AS SELECT 1 AS id;
# --- node_1 ---
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `my_row_id` bigint unsigned NOT NULL AUTO_INCREMENT /*!80023 INVISIBLE */,
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`my_row_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `my_row_id` bigint unsigned NOT NULL AUTO_INCREMENT /*!80023 INVISIBLE */,
  `id` int NOT NULL DEFAULT '0',
  PRIMARY KEY (`my_row_id`)
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# --- node_2 ---
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `my_row_id` bigint unsigned NOT NULL AUTO_INCREMENT /*!80023 INVISIBLE */,
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`my_row_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `my_row_id` bigint unsigned NOT NULL AUTO_INCREMENT /*!80023 INVISIBLE */,
  `id` int NOT NULL DEFAULT '0',
  PRIMARY KEY (`my_row_id`)
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
#
# CREATE TABLE issued on node_2 (GIPK OFF) -> neither node gets my_row_id
#
CREATE TABLE t3 (id INT NOT NULL, c VARCHAR(100)) ENGINE=InnoDB;
CREATE TABLE t4 ENGINE=InnoDB AS SELECT 1 AS id;
# --- node_2 ---
SHOW CREATE TABLE t3;
Table	Create Table
t3	CREATE TABLE `t3` (
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE t4;
Table	Create Table
t4	CREATE TABLE `t4` (
  `id` int NOT NULL DEFAULT '0'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# --- node_1 ---
SHOW CREATE TABLE t3;
Table	Create Table
t3	CREATE TABLE `t3` (
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE t4;
Table	Create Table
t4	CREATE TABLE `t4` (
  `id` int NOT NULL DEFAULT '0'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
#
# ALTER TABLE ... DROP PRIMARY KEY must be accepted or rejected identically
# on both nodes. GIPK mode rejects it (check_primary_key_alter_restrictions),
# so a node applying it under a different setting than the originator would
# fail the write set instead of merely diverging.
#
# From node_2 (GIPK OFF) - allowed, and must apply cleanly on node_1 (GIPK ON)
CREATE TABLE t5 (id INT NOT NULL PRIMARY KEY, c VARCHAR(100)) ENGINE=InnoDB;
ALTER TABLE t5 DROP PRIMARY KEY;
SHOW CREATE TABLE t5;
Table	Create Table
t5	CREATE TABLE `t5` (
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE t5;
Table	Create Table
t5	CREATE TABLE `t5` (
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# From node_1 (GIPK ON) - rejected. DDL is replicated under TOI *before* it
# executes, so the write set does reach node_2 and fails there too, with the
# same error (hence the suppressions above). Both nodes keep the primary key.
CREATE TABLE t6 (id INT NOT NULL PRIMARY KEY, c VARCHAR(100)) ENGINE=InnoDB;
ALTER TABLE t6 DROP PRIMARY KEY;
ERROR 42000: This version of MySQL doesn't yet support 'existing primary key drop without adding a new primary key. In @@sql_generate_invisible_primary_key=ON mode table should have a primary key. Please add a new primary key to be able to drop existing primary key.'
SHOW CREATE TABLE t6;
Table	Create Table
t6	CREATE TABLE `t6` (
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE t6;
Table	Create Table
t6	CREATE TABLE `t6` (
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
#
# A PK-less partitioned table under GIPK ON is rejected - and must be
# rejected on every node, not only on the originator.
#
CREATE TABLE t7 (id INT NOT NULL) ENGINE=InnoDB PARTITION BY HASH(id) PARTITIONS 2;
ERROR 42000: This version of MySQL doesn't yet support 'generating invisible primary key for the partitioned tables'
SELECT COUNT(*) AS t7_on_node_1 FROM information_schema.tables
WHERE table_schema = 'test' AND table_name = 't7';
t7_on_node_1
0
# Anchor the negative check: replicate a statement that *does* succeed and
# wait for it on node_2, so "t7 absent" cannot merely mean "not arrived yet".
CREATE TABLE t7_anchor (id INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;
SELECT COUNT(*) AS t7_on_node_2 FROM information_schema.tables
WHERE table_schema = 'test' AND table_name = 't7';
t7_on_node_2
0
#
# CREATE TABLE ... LIKE <temporary table> keeps working: it is the other
# user of the write-set pre-query channel.
#
CREATE TEMPORARY TABLE t8_tmp (id INT NOT NULL, c VARCHAR(100)) ENGINE=InnoDB;
CREATE TABLE t8 LIKE t8_tmp;
SHOW CREATE TABLE t8;
Table	Create Table
t8	CREATE TABLE `t8` (
  `my_row_id` bigint unsigned NOT NULL AUTO_INCREMENT /*!80023 INVISIBLE */,
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`my_row_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE t8;
Table	Create Table
t8	CREATE TABLE `t8` (
  `my_row_id` bigint unsigned NOT NULL AUTO_INCREMENT /*!80023 INVISIBLE */,
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`my_row_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
#
# The same must hold under wsrep_OSU_method=NBO: ALTER / CREATE INDEX /
# DROP INDEX are exactly the NBO-eligible statements, so every NBO write
# set now carries the originator's setting and applies it on the NBO
# worker thread.
#
CREATE TABLE t9 (id INT NOT NULL PRIMARY KEY, c VARCHAR(100)) ENGINE=InnoDB;
SET SESSION wsrep_OSU_method = NBO;
ALTER TABLE t9 DROP PRIMARY KEY;
SET SESSION wsrep_OSU_method = DEFAULT;
SHOW CREATE TABLE t9;
Table	Create Table
t9	CREATE TABLE `t9` (
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE t9;
Table	Create Table
t9	CREATE TABLE `t9` (
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TEMPORARY TABLE t8_tmp;
DROP TABLE t5, t6, t7_anchor, t8, t9;
DROP TABLE t1, t2, t3, t4;
