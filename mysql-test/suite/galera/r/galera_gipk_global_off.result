include/assert.inc [node_2: t6 definition is identical to node_1]
include/assert.inc [node_1: t7 my_row_id column present = 0]
include/assert.inc [node_1: t7 my_row_id is the PRIMARY key = 0]
include/assert.inc [node_1: t7 my_row_id is AUTO_INCREMENT and INVISIBLE = 0]
include/assert.inc [node_2: t7 my_row_id column present = 0]
include/assert.inc [node_2: t7 my_row_id is the PRIMARY key = 0]
