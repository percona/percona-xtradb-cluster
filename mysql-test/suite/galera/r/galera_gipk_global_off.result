#
# 1. Globals are OFF. Sessions not touched.
#    No table may get my_row_id on any node.
#
SELECT @@global.sql_generate_invisible_primary_key;
@@global.sql_generate_invisible_primary_key
0
SELECT @@global.sql_generate_invisible_primary_key;
@@global.sql_generate_invisible_primary_key
0
CREATE TABLE t1 (id INT NOT NULL, c VARCHAR(100)) ENGINE=InnoDB;
CREATE TABLE t2 ENGINE=InnoDB AS SELECT 1 AS id;
# --- node_1 (originator) ---
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `id` int NOT NULL DEFAULT '0'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# --- node_2 (applier) ---
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `id` int NOT NULL DEFAULT '0'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# --- assert on every node, and that the nodes agree ---
include/assert.inc [node_1: t1 my_row_id column present = 0]
include/assert.inc [node_1: t1 my_row_id is the PRIMARY key = 0]
include/assert.inc [node_1: t1 my_row_id is AUTO_INCREMENT and INVISIBLE = 0]
include/assert.inc [node_2: t1 my_row_id column present = 0]
include/assert.inc [node_2: t1 my_row_id is the PRIMARY key = 0]
include/assert.inc [node_2: t1 my_row_id is AUTO_INCREMENT and INVISIBLE = 0]
include/assert.inc [node_2: t1 definition is identical to node_1]
include/assert.inc [node_1: t2 my_row_id column present = 0]
include/assert.inc [node_1: t2 my_row_id is the PRIMARY key = 0]
include/assert.inc [node_1: t2 my_row_id is AUTO_INCREMENT and INVISIBLE = 0]
include/assert.inc [node_2: t2 my_row_id column present = 0]
include/assert.inc [node_2: t2 my_row_id is the PRIMARY key = 0]
include/assert.inc [node_2: t2 my_row_id is AUTO_INCREMENT and INVISIBLE = 0]
include/assert.inc [node_2: t2 definition is identical to node_1]
DROP TABLE t1, t2;
#
# 2. SET GLOBAL to ON on every node. Sessions not touched.
#    PXC-5140: the appliers session copy still say off,
#    but originating session is ON
#
SET GLOBAL sql_generate_invisible_primary_key = ON;
SET GLOBAL sql_generate_invisible_primary_key = ON;
SELECT @@session.sql_generate_invisible_primary_key;
@@session.sql_generate_invisible_primary_key
1
CREATE TABLE t3 (id INT NOT NULL, c VARCHAR(100)) ENGINE=InnoDB;
CREATE TABLE t4 ENGINE=InnoDB AS SELECT 1 AS id;
CREATE TABLE t5 (id INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;
# --- node_1 (originator) ---
SHOW CREATE TABLE t3;
Table	Create Table
t3	CREATE TABLE `t3` (
  `my_row_id` bigint unsigned NOT NULL AUTO_INCREMENT /*!80023 INVISIBLE */,
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`my_row_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE t4;
Table	Create Table
t4	CREATE TABLE `t4` (
