  `id` int NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# --- node_2 (applier) ---
SHOW CREATE TABLE t3;
Table	Create Table
t3	CREATE TABLE `t3` (
  `my_row_id` bigint unsigned NOT NULL AUTO_INCREMENT /*!80023 INVISIBLE */,
  `id` int NOT NULL,
  `c` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`my_row_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE t4;
Table	Create Table
t4	CREATE TABLE `t4` (
  `my_row_id` bigint unsigned NOT NULL AUTO_INCREMENT /*!80023 INVISIBLE */,
  `id` int NOT NULL DEFAULT '0',
  PRIMARY KEY (`my_row_id`)
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW CREATE TABLE t5;
Table	Create Table
t5	CREATE TABLE `t5` (
  `id` int NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# --- assert on every node, and that the nodes agree ---
include/assert.inc [node_1: t3 my_row_id column present = 1]
include/assert.inc [node_1: t3 my_row_id is the PRIMARY key = 1]
include/assert.inc [node_1: t3 my_row_id is AUTO_INCREMENT and INVISIBLE = 1]
include/assert.inc [node_2: t3 my_row_id column present = 1]
include/assert.inc [node_2: t3 my_row_id is the PRIMARY key = 1]
include/assert.inc [node_2: t3 my_row_id is AUTO_INCREMENT and INVISIBLE = 1]
include/assert.inc [node_2: t3 definition is identical to node_1]
include/assert.inc [node_1: t4 my_row_id column present = 1]
include/assert.inc [node_1: t4 my_row_id is the PRIMARY key = 1]
include/assert.inc [node_1: t4 my_row_id is AUTO_INCREMENT and INVISIBLE = 1]
include/assert.inc [node_2: t4 my_row_id column present = 1]
include/assert.inc [node_2: t4 my_row_id is the PRIMARY key = 1]
include/assert.inc [node_2: t4 my_row_id is AUTO_INCREMENT and INVISIBLE = 1]
include/assert.inc [node_2: t4 definition is identical to node_1]
# t5 declared its own PRIMARY KEY, so no node may add my_row_id.
include/assert.inc [node_1: t5 my_row_id column present = 0]
include/assert.inc [node_1: t5 my_row_id is the PRIMARY key = 0]
include/assert.inc [node_1: t5 my_row_id is AUTO_INCREMENT and INVISIBLE = 0]
include/assert.inc [node_2: t5 my_row_id column present = 0]
include/assert.inc [node_2: t5 my_row_id is the PRIMARY key = 0]
include/assert.inc [node_2: t5 my_row_id is AUTO_INCREMENT and INVISIBLE = 0]
include/assert.inc [node_2: t5 definition is identical to node_1]
DROP TABLE t3, t4, t5;
#
# 3. Globals ON everywhere, but the originating SESSION turns it back OFF
#
SET SESSION sql_generate_invisible_primary_key = OFF;
