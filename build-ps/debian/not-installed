# MySQL Router is intentionally excluded from PXC: -DWITH_ROUTER=OFF in
# debian/rules CMAKE_COMMON_FLAGS skips the router build entirely, so no
# router files land under debian/tmp/. The previous router-related
# exclusion globs were removed in the same commit that disabled the
# build.

# garbd installs duplicate copies of these helpers under usr/share/ on
# deb in addition to the canonical lib/systemd/system/ and usr/bin/
# locations already claimed by percona-xtradb-cluster-garbd.install.
# The usr/share/ copies are leftovers from the upstream galera SCons
# build; drop them rather than shipping two copies in the same package.
usr/share/garb-systemd
usr/share/garb.cnf
usr/share/garb.service

# garbd man page lands under usr/man/ (legacy path) instead of
# usr/share/man/. Excluding it is safer than path-rewriting until the
# galera build is fixed upstream.
usr/man/man8/garbd.8

# Stale debug symbol stub referencing the old 5.7 doc dir. Not
# meaningful on the 9.x line; drop until upstream cleans this up.
usr/share/doc/percona-xtradb-cluster-5.7/mysqld.sym.gz
