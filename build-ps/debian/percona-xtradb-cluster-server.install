# Configuration files and runtime support for the server.
# Binaries and plugins now live in -server-core (via dependency).

# PXC-specific binaries (cluster operations)
usr/bin/clustercheck
usr/bin/pyclustercheck
usr/bin/pxc_extra
usr/bin/wsrep_sst_common
usr/bin/wsrep_sst_xtrabackup-v2
usr/bin/mysql-systemd
# usr/bin/wsrep_sst_rsync
# usr/bin/wsrep_sst_upgrade

# Configuration files
debian/extra/mysql.cnf  etc/mysql/
debian/extra/mysqld.cnf /etc/mysql/mysql.conf.d/
debian/extra/mysql.bootstrap etc/default/

# AppArmor profile
debian/extra/apparmor.d/usr.sbin.mysqld.in2 etc/apparmor.d/
debian/extra/apparmor.d/old_apparmor etc/apparmor.d/
debian/extra/apparmor.d/local/usr.sbin.mysqld.in etc/apparmor.d/local/
debian/extra/apparmor.d/usr.bin.wsrep_sst_xtrabackup-v2.in etc/apparmor.d/

# Server-only data files
usr/share/mysql

# Defaults file
etc/default/mysql

# Telemetry helper scripts (called from postinst/postrm). cmake's
# `make install` places these under usr/libexec/percona-xtradb-cluster/
# via spec.in Source11/Source12 + the equivalent CMake install rules,
# so pick them up from debian/tmp directly. Using `debian/extra/...`
# source paths would orphan the cmake-installed copies under
# debian/tmp/ and trigger dh_missing.
usr/libexec/percona-xtradb-cluster/percona-telemetry-setup.sh
usr/libexec/percona-xtradb-cluster/percona-telemetry-cleanup.sh

# systemd unit files
lib/systemd/system/mysql.service
lib/systemd/system/mysql@.service

# Man pages for PXC-specific binaries (man pages for core binaries
# stay in -server-core)
usr/share/man/man1/mysql.server.1
usr/share/man/man1/mysqlman.1
