# Core server package — binaries, plugins, libraries.
# Mirrors upstream MySQL's mysql-server-core package split.
# Configuration files, init scripts, and AppArmor profiles stay in
# percona-xtradb-cluster-server.

# Server binaries
usr/bin/comp_err
usr/bin/ibd2sdi
usr/bin/innochecksum
usr/bin/myisamchk
usr/bin/myisamlog
usr/bin/myisampack
usr/bin/my_print_defaults
usr/bin/mysql_keyring_encryption_test
usr/bin/mysql_migrate_keyring
usr/bin/mysql_secure_installation
usr/bin/mysql_tzinfo_to_sql
usr/bin/mysqlbinlog
usr/bin/mysqld_multi
usr/bin/mysqld_safe
usr/bin/mysqltest
usr/bin/perror
usr/bin/ps_mysqld_helper
usr/sbin/mysqld

# All server-side plugins. Client auth plugins (listed explicitly in
# percona-xtradb-cluster-client-plugins.install) are claimed by that
# package first via dh_install ordering, so this glob picks up only
# the server plugins that remain.
usr/lib/mysql/plugin/*.so

# Galera replication library (special syntax: source path is
# debian/tmp/libgalera_smm.so, installed to usr/lib/galera4/).
libgalera_smm.so usr/lib/galera4

# Bundled shared libraries
usr/lib/mysql/private/libprotobuf-lite.so.*
usr/lib/mysql/private/libprotobuf.so.*
usr/lib/mysql/private/libabsl_*.so

# ICU data files
usr/lib/mysql/private/icudt77l/*.icu
usr/lib/mysql/private/icudt77l/brkitr/*

# Man pages for binaries shipped here
usr/share/man/man1/comp_err.1
usr/share/man/man1/ibd2sdi.1
usr/share/man/man1/innochecksum.1
usr/share/man/man1/myisamchk.1
usr/share/man/man1/myisamlog.1
usr/share/man/man1/myisampack.1
usr/share/man/man1/my_print_defaults.1
usr/share/man/man1/mysql_secure_installation.1
usr/share/man/man1/mysql_tzinfo_to_sql.1
usr/share/man/man1/mysqlbinlog.1
usr/share/man/man1/mysqld_multi.1
usr/share/man/man1/mysqld_safe.1
usr/share/man/man1/perror.1
usr/share/man/man8/mysqld.8
